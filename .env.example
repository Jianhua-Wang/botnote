# Auth: a password turns enforcement on; loopback callers stay token-free.
# BOTNOTE_PASSWORD=
# BOTNOTE_REQUIRE_AUTH=1
# BOTNOTE_TRUST_LOCALHOST=1
# BOTNOTE_TRUST_PROXY=loopback
